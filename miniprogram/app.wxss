/**app.wxss**/
page {
  min-height: 100%;
  background-color: #F5F7FB;
  background-image: linear-gradient(180deg, #FDFEFF 0%, #F1F3F8 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  color: var(--text-primary);
}

/* 设计令牌 */
:root {
  --primary-color: #0A84FF;
  --primary-weak: rgba(10, 132, 255, 0.16);
  --surface-color: #FFFFFF;
  --surface-muted: rgba(255, 255, 255, 0.8);
  --border-color: rgba(15, 23, 42, 0.08);
  --text-primary: #1B1C1F;
  --text-secondary: rgba(27, 28, 31, 0.6);
  --text-tertiary: rgba(27, 28, 31, 0.35);
  --success-color: #30D158;
  --warning-color: #FF9F0A;
  --danger-color: #FF453A;
  --shadow-soft: 0 12rpx 40rpx rgba(15, 23, 42, 0.08);
}

.container {
  padding: 32rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-heading {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}

.card {
  background: var(--surface-color);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-soft);
  border: 1px solid var(--border-color);
}

.surface {
  background: var(--surface-color);
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-soft);
}

.glass-card {
  background: var(--surface-muted);
  border-radius: 36rpx;
  padding: 32rpx;
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.12);
}

.inline-card {
  background: rgba(255, 255, 255, 0.65);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 20rpx 48rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background-color: var(--primary-color);
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(10, 132, 255, 0.35);
}

.btn-secondary {
  background-color: rgba(10, 132, 255, 0.12);
  color: var(--primary-color);
}

.ghost-btn {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-tertiary); }
.text-center { text-align: center; }
.text-right { text-align: right; }
.font-xs { font-size: 22rpx; }
.font-sm { font-size: 26rpx; }
.font-md { font-size: 30rpx; }
.font-lg { font-size: 34rpx; }
.font-xl { font-size: 40rpx; }

.muted {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  background-color: rgba(15, 23, 42, 0.06);
  color: var(--text-secondary);
}

.chip-primary {
  background: var(--primary-weak);
  color: var(--primary-color);
}

.badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(27, 28, 31, 0.04);
  color: var(--text-secondary);
}

.pill-input {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 20rpx 28rpx;
  border: 1px solid transparent;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.04);
}

.pill-input:focus-within {
  border-color: rgba(10, 132, 255, 0.45);
  box-shadow: 0 12rpx 30rpx rgba(10, 132, 255, 0.18);
}

.icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(10, 132, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--primary-color);
}

.divider {
  width: 100%;
  height: 2rpx;
  background-color: rgba(15, 23, 42, 0.06);
  margin: 24rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--text-secondary);
  gap: 20rpx;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(10, 132, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 24rpx;
  color: var(--text-secondary);
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(27, 28, 31, 0.08);
  border-top-color: var(--primary-color);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 兼容旧版工具类 */
.flex { display: flex; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.mr-10 { margin-right: 10rpx; }
