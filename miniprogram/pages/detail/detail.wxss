/* pages/detail/detail.wxss */

.detail-screen {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 80rpx;
}

.stop-card {
  gap: 24rpx;
}

.stop-chip {
  width: fit-content;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  font-size: 22rpx;
}

.stop-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stop-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}

.stop-meta {
  flex: 1;
  min-width: 0;
}

.stop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.stop-address {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.favorite-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
}

.stop-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.9);
}

.update-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.refresh-pill {
  padding: 12rpx 30rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 26rpx;
}

.arrivals-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.arrival-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
}

.route-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  max-width: 70%;
}

.route-number {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.route-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.arrival-times {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.arrival-chip {
  min-width: 96rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(15, 23, 42, 0.04);
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.arrival-chip:first-child {
  background: rgba(10, 132, 255, 0.12);
  color: var(--primary-color);
  box-shadow: 0 12rpx 24rpx rgba(10, 132, 255, 0.16);
}

.arrival-minute {
  font-size: 30rpx;
}

.arrival-unit {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.arrival-empty {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 80rpx 20rpx;
  text-align: center;
}

.error-icon {
  font-size: 96rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
