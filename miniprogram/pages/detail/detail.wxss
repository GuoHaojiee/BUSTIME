/* pages/detail/detail.wxss */

/* 站点头部 */
.stop-header {
  margin: 20rpx;
}

.stop-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.stop-title-info {
  display: flex;
  align-items: flex-start;
  flex: 1;
}

.stop-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.stop-title-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.stop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 8rpx;
}

.stop-address {
  font-size: 24rpx;
  color: #969799;
}

.favorite-btn {
  padding: 0 10rpx;
}

.favorite-icon {
  font-size: 44rpx;
}

.update-time {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #969799;
  padding-top: 20rpx;
  border-top: 1px solid #EBEDF0;
}

.time-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.refresh-btn {
  margin-left: auto;
  color: #1989FA;
  padding: 0 10rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
  color: #969799;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #1989FA;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
}

.error-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #969799;
  margin-bottom: 20rpx;
}

/* 到站信息列表 */
.arrivals-list {
  padding: 0 20rpx 20rpx;
}

.arrival-item {
  margin-bottom: 20rpx;
}

/* 线路头部 */
.route-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid #EBEDF0;
}

.route-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.route-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.route-text {
  display: flex;
  flex-direction: column;
}

.route-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 4rpx;
}

.route-name {
  font-size: 24rpx;
  color: #969799;
}

/* 到站时间 */
.arrival-times {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.arrival-time-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.time-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  min-width: 100rpx;
}

.time-value {
  font-size: 36rpx;
  font-weight: bold;
  color: inherit;
  line-height: 1;
  margin-bottom: 4rpx;
}

.time-unit {
  font-size: 20rpx;
  color: inherit;
  opacity: 0.8;
}

.arrival-direction {
  font-size: 20rpx;
  color: #969799;
  margin-top: 8rpx;
  text-align: center;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.no-arrivals {
  font-size: 24rpx;
  color: #969799;
  padding: 20rpx 0;
}
