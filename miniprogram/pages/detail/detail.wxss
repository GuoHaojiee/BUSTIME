/* pages/detail/detail.wxss */

.detail-screen {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 80rpx;
}

.stop-card {
  gap: 24rpx;
}

.stop-chip {
  width: fit-content;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  font-size: 22rpx;
}

.stop-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stop-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}

.stop-meta {
  flex: 1;
  min-width: 0;
}

.stop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.stop-address {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.favorite-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
}

.stop-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.9);
}

.update-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.refresh-pill {
  padding: 12rpx 30rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 26rpx;
}

.arrivals-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.arrival-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.route-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.route-chip {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(10, 132, 255, 0.12);
  color: var(--primary-color);
  font-weight: 600;
  font-size: 28rpx;
}

.route-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.arrival-times {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.arrival-pill {
  min-width: 200rpx;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  background: rgba(15, 23, 42, 0.05);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.arrival-pill.primary {
  background: rgba(10, 132, 255, 0.12);
  color: var(--primary-color);
  box-shadow: 0 10rpx 25rpx rgba(10, 132, 255, 0.2);
}

.arrival-time {
  font-size: 34rpx;
  font-weight: 600;
}

.arrival-direction {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.no-arrivals {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 80rpx 20rpx;
  text-align: center;
}

.error-icon {
  font-size: 96rpx;
}

.error-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
