<!--pages/detail/detail.wxml-->
<view class="container">
  <!-- 站点信息 -->
  <view class="stop-header card">
    <view class="stop-title-row">
      <view class="stop-title-info">
        <text class="stop-icon">📍</text>
        <view class="stop-title-text">
          <text class="stop-name">{{stopName}}</text>
          <text class="stop-address">{{stopAddress}}</text>
        </view>
      </view>
      <view class="favorite-btn" bindtap="toggleFavorite">
        <text class="favorite-icon">{{isFavorite ? '⭐' : '☆'}}</text>
      </view>
    </view>

    <!-- 更新时间 -->
    <view wx:if="{{updateTime}}" class="update-time">
      <text class="time-icon">🕐</text>
      <text>更新时间: {{updateTime}}</text>
      <text class="refresh-btn" bindtap="onRefresh">刷新</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-state">
    <view class="error-icon">⚠️</view>
    <view class="error-text">{{error}}</view>
    <button class="btn btn-primary mt-20" bindtap="onRetry">
      重新加载
    </button>
  </view>

  <!-- 到站信息列表 -->
  <view wx:elif="{{arrivals.length > 0}}" class="arrivals-list">
    <view wx:for="{{arrivals}}" wx:key="routeNumber" class="arrival-item card">
      <!-- 线路信息 -->
      <view class="route-header">
        <view class="route-info">
          <text class="route-icon">🚌</text>
          <view class="route-text">
            <text class="route-number">{{item.routeNumber}}</text>
            <text class="route-name">{{item.routeName}}</text>
          </view>
        </view>
      </view>

      <!-- 到站时间列表 -->
      <view class="arrival-times">
        <view
          wx:for="{{item.arrivals}}"
          wx:for-item="arrival"
          wx:for-index="arrivalIndex"
          wx:key="vehicleId"
          class="arrival-time-item"
        >
          <view class="time-badge" style="{{arrivalIndex === 0 ? 'background-color: #1989FA; color: white;' : ''}}">
            <text class="time-value">{{arrival.minutes}}</text>
            <text class="time-unit">分钟</text>
          </view>
          <view wx:if="{{arrival.direction}}" class="arrival-direction">
            → {{arrival.direction}}
          </view>
        </view>

        <!-- 无到站信息 -->
        <view wx:if="{{item.arrivals.length === 0}}" class="no-arrivals">
          暂无到站信息
        </view>
      </view>
    </view>
  </view>

  <!-- 无数据 -->
  <view wx:else class="empty-state">
    <view class="empty-icon">🚌</view>
    <view class="empty-text">暂无到站信息</view>
    <view class="empty-hint">请稍后刷新查看</view>
    <button class="btn btn-primary mt-20" bindtap="onRefresh">
      刷新
    </button>
  </view>
</view>
