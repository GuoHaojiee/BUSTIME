<!--pages/detail/detail.wxml-->
<view class="container detail-screen">
  <!-- 站点信息 -->
  <view class="stop-card glass-card">
    <view class="stop-chip">站点</view>
    <view class="stop-header">
      <view class="stop-icon">📍</view>
      <view class="stop-meta">
        <view class="stop-name">{{stopName}}</view>
        <view class="stop-address">{{stopAddress}}</view>
      </view>
      <view class="favorite-btn" bindtap="toggleFavorite">
        <text class="favorite-icon">{{isFavorite ? '★' : '☆'}}</text>
      </view>
    </view>
    <view class="stop-footer">
      <view class="update-info">
        <text class="time-icon">🕐</text>
        <text>{{updateTime || '等待刷新...'}}</text>
      </view>
      <view class="refresh-pill" bindtap="onRefresh">刷新</view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text>正在获取实时到站数据...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-state card">
    <view class="error-icon">⚠️</view>
    <view class="error-text">{{error}}</view>
    <button class="btn btn-primary" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 到站信息列表 -->
  <view wx:elif="{{arrivals.length > 0}}" class="arrivals-section">
    <view class="section-heading">即将到站</view>
    <view
      wx:for="{{arrivals}}"
      wx:key="routeNumber"
      class="arrival-row card"
    >
      <view class="route-info">
        <view class="route-number">{{item.routeNumber}}</view>
        <view wx:if="{{item.routeName}}" class="route-name">{{item.routeName}}</view>
      </view>
      <view class="arrival-times" wx:if="{{item.upcomingArrivals.length > 0}}">
        <view
          wx:for="{{item.upcomingArrivals}}"
          wx:key="vehicleId"
          class="arrival-chip"
        >
          <text class="arrival-minute">{{item.minutes === 0 ? '即将' : item.minutes}}</text>
          <text wx:if="{{item.minutes !== 0}}" class="arrival-unit">分钟</text>
        </view>
      </view>
      <view wx:else class="arrival-empty">暂无</view>
    </view>
  </view>

  <!-- 无数据 -->
  <view wx:else class="empty-state inline-card">
    <view class="empty-icon">🚌</view>
    <view class="empty-text">暂无到站信息</view>
    <view class="empty-hint">稍后再试或刷新数据</view>
    <button class="btn btn-primary" bindtap="onRefresh">刷新</button>
  </view>
</view>
