/* pages/search/search.wxss */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #fff;
  border-bottom: 1px solid #EBEDF0;
}

.search-back {
  font-size: 40rpx;
  color: #323233;
  padding: 0 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F7F8FA;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  margin: 0 16rpx;
  position: relative;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #323233;
}

.clear-btn {
  font-size: 40rpx;
  color: #C8C9CC;
  padding: 0 10rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #1989FA;
  padding: 0 10rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
  color: #969799;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #1989FA;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 搜索结果 */
.search-results {
  padding: 20rpx;
}

.result-list {
}

.result-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}

.result-item:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.result-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.result-content {
  flex: 1;
}

.result-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 8rpx;
}

.result-address {
  font-size: 24rpx;
  color: #969799;
}

.result-arrow {
  font-size: 40rpx;
  color: #C8C9CC;
  margin-left: 20rpx;
}

/* 搜索建议 */
.search-suggestions {
  padding: 20rpx;
}

/* 搜索历史 */
.history-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
}

.clear-history {
  font-size: 24rpx;
  color: #969799;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background-color: #F7F8FA;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #323233;
}

.history-icon {
  margin-right: 10rpx;
}

/* 搜索提示 */
.search-tips {
  background-color: #F7F8FA;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #969799;
  line-height: 2;
}
