/* pages/search/search.wxss */

.search-screen {
  padding-bottom: 60rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.search-back {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--text-primary);
  box-shadow: var(--shadow-soft);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 0 16rpx 0 24rpx;
  border: 1px solid rgba(15, 23, 42, 0.08);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  padding: 20rpx 0;
  color: var(--text-primary);
}

.clear-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-secondary);
}

.search-btn {
  padding: 0 30rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: var(--primary-color);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 28rpx;
  box-shadow: 0 15rpx 30rpx rgba(10, 132, 255, 0.35);
}

.search-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.search-results,
.search-suggestions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.result-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.result-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(10, 132, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--primary-color);
}

.result-content {
  flex: 1;
  min-width: 0;
}

.result-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.result-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.result-arrow {
  font-size: 38rpx;
  color: var(--text-tertiary);
}

.suggestion-card {
  gap: 20rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  color: var(--text-primary);
  font-size: 26rpx;
}

.history-actions {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.clear-history {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.history-empty {
  font-size: 26rpx;
}

.tips-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.tip-item {
  font-size: 26rpx;
  color: var(--text-secondary);
}
