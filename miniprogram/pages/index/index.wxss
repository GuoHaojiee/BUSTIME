/* pages/index/index.wxss */

.home-screen {
  padding-bottom: 160rpx;
}

.home-hero {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  background-image: linear-gradient(135deg, #0A84FF, #66A6FF 65%, #70D6FF);
  color: #fff;
}

.hero-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  padding: 6rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 8rpx;
  text-transform: uppercase;
  background: rgba(255, 255, 255, 0.15);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
}

.cta-icon {
  font-size: 36rpx;
}

.cta-arrow {
  font-size: 40rpx;
  opacity: 0.8;
}

.favorites-section {
  margin-top: 20rpx;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 28rpx;
  padding: 32rpx;
  background: #fff;
  box-shadow: var(--shadow-soft);
  border: 1px solid var(--border-color);
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.favorite-item:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.favorite-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.favorite-icon {
  font-size: 40rpx;
}

.favorite-text {
  flex: 1;
  min-width: 0;
}

.favorite-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.favorite-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.favorite-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.favorite-delete {
  font-size: 26rpx;
  color: var(--danger-color);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 69, 58, 0.08);
}

.favorite-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: #111827;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  box-shadow: 0 20rpx 40rpx rgba(17, 24, 39, 0.35);
  z-index: 10;
  transition: transform 0.2s ease;
}

.fab:active {
  transform: translateY(6rpx);
}
