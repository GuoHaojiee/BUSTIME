<!--pages/index/index.wxml-->
<view class="container home-screen">
  <!-- 英雄区 -->
  <view class="home-hero glass-card">
    <view class="hero-meta">
      <view class="hero-badge">Bustime</view>
      <view class="hero-title">莫斯科公交</view>
    </view>
    <view class="hero-cta" bindtap="goToSearch">
      <text class="cta-icon">🔍</text>
      <text class="cta-label">立即搜索站点</text>
      <text class="cta-arrow">›</text>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="section favorites-section">
    <view class="section-heading">我的收藏</view>

    <!-- 空状态 -->
    <view wx:if="{{favorites.length === 0}}" class="empty-state inline-card">
      <view class="empty-icon">⭐</view>
      <view class="empty-text">还没有收藏站点</view>
      <view class="empty-hint">在站点详情页轻点星标即可收藏</view>
      <button class="btn btn-primary" bindtap="goToSearch">
        搜索并添加
      </button>
    </view>

    <!-- 收藏列表 -->
    <view wx:else class="favorite-list">
      <view
        wx:for="{{favorites}}"
        wx:key="id"
        class="favorite-item surface"
        bindtap="viewStopDetail"
        data-stop-id="{{item.id}}"
      >
        <view class="favorite-info">
          <view class="favorite-icon">📍</view>
          <view class="favorite-text">
            <view class="favorite-name">{{item.name}}</view>
            <view class="favorite-address">{{item.address}}</view>
          </view>
        </view>
        <view class="favorite-actions">
          <view
            class="favorite-delete"
            catchtap="deleteFavorite"
            data-stop-id="{{item.id}}"
            data-stop-name="{{item.name}}"
          >
            删除
          </view>
          <text class="favorite-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="fab" bindtap="goToSearch">
    <text>＋</text>
  </view>
</view>
