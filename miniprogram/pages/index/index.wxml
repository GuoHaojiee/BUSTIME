<!--pages/index/index.wxml-->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-box" bindtap="goToSearch">
    <view class="search-input">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索公交站点...</text>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="section">
    <view class="section-title">我的收藏</view>

    <!-- 空状态 -->
    <view wx:if="{{favorites.length === 0}}" class="empty-state">
      <view class="empty-icon">⭐</view>
      <view class="empty-text">还没有收藏任何站点</view>
      <button class="btn btn-primary mt-20" bindtap="goToSearch">
        搜索站点
      </button>
    </view>

    <!-- 收藏列表 -->
    <view wx:else class="favorite-list">
      <view
        wx:for="{{favorites}}"
        wx:key="id"
        class="favorite-item card"
        bindtap="viewStopDetail"
        data-stop-id="{{item.id}}"
      >
        <view class="favorite-content">
          <view class="stop-icon">📍</view>
          <view class="stop-info">
            <view class="stop-name">{{item.name}}</view>
            <view class="stop-address">{{item.address}}</view>
          </view>
        </view>
        <view class="favorite-actions">
          <view
            class="delete-btn"
            catchtap="deleteFavorite"
            data-stop-id="{{item.id}}"
            data-stop-name="{{item.name}}"
          >
            删除
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="fab" bindtap="goToSearch">
    <text>+</text>
  </view>
</view>
