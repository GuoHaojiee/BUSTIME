/* pages/favorites/favorites.wxss */

.favorites-screen {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 80rpx;
}

.favorites-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.8);
}

.hero-count {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #fff;
}

.action-btn {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.9;
}

.action-btn.danger {
  color: #ffd1d1;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.hero-cta {
  width: fit-content;
  padding: 14rpx 30rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 26rpx;
}

.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.favorite-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.favorite-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(10, 132, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--primary-color);
}

.favorite-info {
  flex: 1;
  min-width: 0;
}

.favorite-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.favorite-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.favorite-added {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.favorite-tail {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.favorite-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

.delete-chip {
  padding: 10rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 69, 58, 0.12);
  color: var(--danger-color);
  font-size: 26rpx;
}

.favorite-item.editing .favorite-main {
  opacity: 0.6;
}
