<!--pages/favorites/favorites.wxml-->
<view class="container favorites-screen">
  <!-- 头部 -->
  <view class="favorites-hero glass-card">
    <view class="hero-top">
      <view>
        <view class="hero-label">收藏站点</view>
        <view class="hero-count">{{favorites.length}}</view>
      </view>
      <view class="hero-actions">
        <text class="action-btn" bindtap="toggleEdit">
          {{isEditing ? '完成' : '编辑'}}
        </text>
        <text
          wx:if="{{isEditing && favorites.length > 0}}"
          class="action-btn danger"
          bindtap="clearAllFavorites"
        >
          清空
        </text>
      </view>
    </view>
    <view class="hero-subtitle">
      常用站点会在这里集合，单手即可查看与管理
    </view>
    <view class="hero-cta" bindtap="goToSearch">
      <text>＋ 添加新的站点</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{favorites.length === 0}}" class="empty-state inline-card">
    <view class="empty-icon">⭐</view>
    <view class="empty-text">还没有收藏任何站点</view>
    <view class="empty-hint">在站点详情页点击星标即可收藏</view>
    <button class="btn btn-primary" bindtap="goToSearch">去搜索</button>
  </view>

  <!-- 收藏列表 -->
  <view wx:else class="favorites-list">
    <view
      wx:for="{{favorites}}"
      wx:key="id"
      class="favorite-item card {{isEditing ? 'editing' : ''}}"
    >
      <view class="favorite-main" bindtap="viewStopDetail" data-stop="{{item}}">
        <view class="favorite-icon">📍</view>
        <view class="favorite-info">
          <view class="favorite-name">{{item.name}}</view>
          <view class="favorite-address">{{item.address}}</view>
          <view wx:if="{{item.addedAt}}" class="favorite-added">
            收藏于 {{item.addedAt}}
          </view>
        </view>
      </view>
      <view class="favorite-tail">
        <view
          wx:if="{{isEditing}}"
          class="delete-chip"
          catchtap="deleteFavorite"
          data-stop-id="{{item.id}}"
          data-stop-name="{{item.name}}"
        >
          删除
        </view>
        <text wx:else class="favorite-arrow">›</text>
      </view>
    </view>
  </view>
</view>
